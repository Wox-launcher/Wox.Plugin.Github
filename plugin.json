{
  "Id": "35E4296B-89E2-492E-977B-0120ECCB5C95",
  "TriggerKeywords": ["gh", "github"],
  "Name": "i18n:plugin_name",
  "Description": "i18n:plugin_description",
  "Author": "qianlifeng",
  "Version": "0.1.0",
  "MinWoxVersion": "2.0.0",
  "Runtime": "nodejs",
  "Website": "https://github.com/qianlifeng/Wox.Plugin.Github",
  "Entry": "index.js",
  "Icon": "relative:images/app.svg",
  "SupportedOS": ["windows", "linux", "darwin"],
  "Commands": [
    {
      "Command": "issues",
      "Description": "i18n:command_issues_description"
    },
    {
      "Command": "notifications",
      "Description": "i18n:command_notifications_description"
    }
  ],
  "QueryRequirements": {
    "AnyQuery": [
      {
        "SettingKey": "personalAccessToken",
        "Validators": [{ "Type": "not_empty" }],
        "Message": "i18n:setup_token_required_title"
      }
    ]
  },
  "SettingDefinitions": [
    {
      "Type": "textbox",
      "Value": {
        "Key": "personalAccessToken",
        "Label": "i18n:setting_pat_label",
        "Tooltip": "i18n:setting_pat_tooltip",
        "DefaultValue": "",
        "MaxLines": 1,
        "Style": {
          "Width": 520
        }
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "numberOfResults",
        "Label": "i18n:setting_number_of_results_label",
        "Tooltip": "i18n:setting_number_of_results_tooltip",
        "DefaultValue": "20",
        "MaxLines": 1,
        "Validators": [
          {
            "Type": "is_number",
            "Value": {
              "IsInteger": true,
              "IsFloat": false
            }
          }
        ],
        "Style": {
          "Width": 180
        }
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "issueSort",
        "Label": "i18n:setting_issue_sort_label",
        "Tooltip": "i18n:setting_issue_sort_tooltip",
        "DefaultValue": "updated-desc",
        "IsMulti": false,
        "Options": [
          {
            "Label": "i18n:sort_updated_desc",
            "Value": "updated-desc"
          },
          {
            "Label": "i18n:sort_updated_asc",
            "Value": "updated-asc"
          },
          {
            "Label": "i18n:sort_created_desc",
            "Value": "created-desc"
          },
          {
            "Label": "i18n:sort_created_asc",
            "Value": "created-asc"
          },
          {
            "Label": "i18n:sort_comments_desc",
            "Value": "comments-desc"
          },
          {
            "Label": "i18n:sort_comments_asc",
            "Value": "comments-asc"
          }
        ],
        "Validators": [],
        "Style": {
          "Width": 280
        }
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showCreated",
        "Label": "i18n:setting_show_created_label",
        "Tooltip": "i18n:setting_show_created_tooltip",
        "DefaultValue": "true",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showAssigned",
        "Label": "i18n:setting_show_assigned_label",
        "Tooltip": "i18n:setting_show_assigned_tooltip",
        "DefaultValue": "true",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showMentioned",
        "Label": "i18n:setting_show_mentioned_label",
        "Tooltip": "i18n:setting_show_mentioned_tooltip",
        "DefaultValue": "true",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showRecentlyClosed",
        "Label": "i18n:setting_show_recently_closed_label",
        "Tooltip": "i18n:setting_show_recently_closed_tooltip",
        "DefaultValue": "false",
        "Style": {}
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "select",
      "Value": {
        "Key": "repositoryFilterMode",
        "Label": "i18n:setting_repository_filter_mode_label",
        "Tooltip": "i18n:setting_repository_filter_mode_tooltip",
        "DefaultValue": "all",
        "IsMulti": false,
        "Options": [
          {
            "Label": "i18n:repository_filter_all",
            "Value": "all"
          },
          {
            "Label": "i18n:repository_filter_include",
            "Value": "include"
          },
          {
            "Label": "i18n:repository_filter_exclude",
            "Value": "exclude"
          }
        ],
        "Validators": [],
        "Style": {
          "Width": 320
        }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "repositoryList",
        "Label": "i18n:setting_repository_list_label",
        "Tooltip": "i18n:setting_repository_list_tooltip",
        "DefaultValue": "",
        "MaxLines": 4,
        "Style": {
          "Width": 520
        }
      }
    }
  ],
